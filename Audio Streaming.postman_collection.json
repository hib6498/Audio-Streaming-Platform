        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const refreshToken = pm.collectionVariables.get(\"jwtRT\");\r",
                  "\r",
                  "if (refreshToken) {\r",
                  "    pm.request.headers.upsert({\r",
                  "        key: \"Cookie\",\r",
                  "        value: `jwtRT=${refreshToken}`\r",
                  "    });\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();\r",
                  "\r",
                  "if (json.accessToken) {\r",
                  "    pm.collectionVariables.set(\"accessToken\", json.accessToken);\r",
                  "    console.log(\"Access token saved\");\r",
                  "} else {\r",
                  "    console.log(\"Access token not found in response\");\r",
                  "}\r",
                  "\r",
                  "const refreshToken = pm.cookies.get(\"jwtRT\");\r",
                  "\r",
                  "if (refreshToken) {\r",
                  "    pm.collectionVariables.set(\"jwtRT\", refreshToken);\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
