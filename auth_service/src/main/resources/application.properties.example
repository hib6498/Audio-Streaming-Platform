spring.application.name=<your-application-name>
server.servlet.context-path=/api/v1

spring.jpa.generate-ddl=true
spring.jpa.hibernate.ddl-auto=<none|update|create|create-drop>
spring.jpa.show-sql=<true|false>

spring.datasource.url=jdbc:postgresql://<db-host>:<db-port>/<db-name>
spring.datasource.username=<db-username>
spring.datasource.password=<db-password>
spring.datasource.driver-class-name=org.postgresql.Driver

#optional
spring.datasource.host=<db-host>
spring.datasource.port=<db-port>

logging.level.org.springframework.security=<DEBUG|INFO|WARN|ERROR>

REFRESH_KEY=<random-secret-or-key>
ACCESS_TOKEN_EXPIRATION=<minutes>
REFRESH_TOKEN_EXPIRATION=<days>
